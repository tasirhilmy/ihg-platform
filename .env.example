# ==========================================
# IHG Platform - Environment Variables
# ==========================================
# Copy this file to `.env` and fill in your values.

# ----- Database -----
# For local dev: SQLite (no setup needed)
# For production: PostgreSQL connection string
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/ihg_platform?schema=public"

# ----- NextAuth -----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-strong-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ----- Email (Mock for demo) -----
# When EMAIL_MOCK=true, emails are logged to console + saved to DB (EmailLog table)
# Set to false and configure SMTP for real emails
EMAIL_MOCK="true"
EMAIL_FROM="IHG Platform <noreply@ihg.example.com>"

# For production SMTP (optional):
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="587"
# SMTP_USER="resend"
# SMTP_PASS="re_xxxxx"

# ----- Payments (Demo mode) -----
# Payment gateway is stubbed for the demo phase
PAYMENT_DEMO_MODE="true"

# ----- App Settings -----
NODE_ENV="development"
APP_NAME="IHG Platform"
APP_URL="http://localhost:3000"
